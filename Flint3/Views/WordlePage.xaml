<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flint3.Views.WordlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flint3.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Flint3.ViewModels"
    xmlns:keyvisual="using:Flint3.Controls.KeyVisual"
    xmlns:cvt="using:Flint3.Converters"
    mc:Ignorable="d"
    Background="Transparent" NavigationCacheMode="Disabled" IsTabStop="True" Loaded="Page_Loaded">

    <Page.Resources>
        <cvt:WordleState2BrushConverter x:Key="State2Brush"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--标题-->
        <Grid Grid.Row="0">
            <TextBlock Text="Wordle" FontFamily="Times New Roman" Margin="20,0,0,4" FontWeight="Bold" FontSize="20" VerticalAlignment="Bottom" Opacity="0.9"/>
            <TextBlock Text="{x:Bind ViewModel.DateText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,8" FontSize="12" Opacity="0.5"/>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="10" Margin="16,4,16,12">

                <!--猜测面板-->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WordleRowViewModel">
                            <ItemsControl ItemsSource="{x:Bind Cells}" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WordleCellViewModel">
                                        <Border Width="42" Height="42" CornerRadius="4" BorderThickness="2"
                                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                                Background="{x:Bind State, Mode=OneWay, Converter={StaticResource State2Brush}}">
                                            <TextBlock Text="{x:Bind Letter, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="StatusTextBlock" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" HorizontalAlignment="Center" FontSize="13" Opacity="0.8" Height="18"/>

                <!--屏幕键盘-->
                <ItemsControl ItemsSource="{x:Bind ViewModel.KeyboardRow1}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WordleKeyViewModel">
                            <keyvisual:KeyVisual Content="{x:Bind Display}" Tag="{x:Bind Display}" Width="30" Height="36" MinWidth="0" MinHeight="0"
                                                 Padding="0" Margin="0,0,6,0" FontSize="13" FontWeight="SemiBold"
                                                 Background="{x:Bind State, Mode=OneWay, Converter={StaticResource State2Brush}, ConverterParameter=key}"
                                                 Tapped="OnKeyTapped"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{x:Bind ViewModel.KeyboardRow2}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WordleKeyViewModel">
                            <keyvisual:KeyVisual Content="{x:Bind Display}" Tag="{x:Bind Display}" Width="30" Height="36" MinWidth="0" MinHeight="0"
                                                 Padding="0" Margin="0,0,6,0" FontSize="13" FontWeight="SemiBold"
                                                 Background="{x:Bind State, Mode=OneWay, Converter={StaticResource State2Brush}, ConverterParameter=key}"
                                                 Tapped="OnKeyTapped"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{x:Bind ViewModel.KeyboardRow3}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WordleKeyViewModel">
                            <keyvisual:KeyVisual Content="{x:Bind Display}" Tag="{x:Bind Display}" Width="30" Height="36" MinWidth="0" MinHeight="0"
                                                 Padding="0" Margin="0,0,6,0" FontSize="13" FontWeight="SemiBold"
                                                 Background="{x:Bind State, Mode=OneWay, Converter={StaticResource State2Brush}, ConverterParameter=key}"
                                                 Tapped="OnKeyTapped"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Button Content="Enter" MinWidth="56" Height="32" Padding="8,0" Click="OnClickSubmit"/>
                    <Button Content="Del" MinWidth="40" Height="32" Padding="8,0" Click="OnClickBackspace"/>
                    <Button x:Name="ResetButton" Content="重置" Height="32" Padding="8,0" Click="OnClickReset"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--工具栏-->
        <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="2" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Fill="{ThemeResource ControlElevationBorderBrush}"/>
            <Button Grid.Column="0" Margin="8,8,0,8" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" Click="OnClickBackButton">
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <TextBlock>
                            <Run Text="back" FontWeight="Bold"/>
                            <Run Text="/bæk/"/>
                            <Run Text="adverb" FontStyle="Italic" FontWeight="Medium"/>
                            <Run Text="返回"/>
                        </TextBlock>
                    </ToolTip>
                </ToolTipService.ToolTip>
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72B;" FontSize="16" Height="22" Width="22" Opacity="0.8"/>
            </Button>
        </Grid>
    </Grid>
</Page>
